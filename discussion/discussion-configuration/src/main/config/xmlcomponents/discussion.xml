<WAComponent xmlns="http://silverpeas.org/xml/ns/component" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://silverpeas.org/xml/ns/component https://www.silverpeas.org/xsd/component.xsd">
  <name>discussion</name>
  <label>
    <message lang="fr">Discussion</message>
    <message lang="en">Discussion</message>
    <message lang="de">Diskussion</message>
  </label>
  <description>
    <message lang="fr">Une conversation collaborative persistante par instance.</message>
    <message lang="en">One persistent collaborative conversation per instance.</message>
    <message lang="de">Eine dauerhafte gemeinsame Diskussion pro Instanz.</message>
  </description>
  <suite>
    <message lang="fr">02 Gestion Collaborative</message>
    <message lang="en">02 Collaborative Management</message>
    <message lang="de">02 kollaborative Verwaltung</message>
  </suite>
  <visible>true</visible>
  <portlet>false</portlet>
  <profiles>
    <profile name="admin">
      <label>
        <message lang="fr">Gestionnaires</message>
        <message lang="en">Managers</message>
        <message lang="de">Manager</message>
      </label>
      <help>
        <message lang="fr">Gérer tous les messages.</message>
        <message lang="en">Manage all messages.</message>
        <message lang="de">Alle Nachrichten verwalten.</message>
      </help>
      <spaceMapping>
        <profile>admin</profile>
      </spaceMapping>
    </profile>
    <profile name="writer">
      <label>
        <message lang="fr">Rédacteurs</message>
        <message lang="en">Writers</message>
        <message lang="de">Redaktor</message>
      </label>
      <help>
        <message lang="fr">Publier et gérer ses messages.</message>
        <message lang="en">Publish and manage own messages.</message>
        <message lang="de">Eigene Nachrichten schreiben und verwalten.</message>
      </help>
      <spaceMapping>
        <profile>writer</profile>
      </spaceMapping>
    </profile>
  </profiles>
  <parameters>
    <parameter>
      <name>maxImagesPerMessage</name>
      <label>
        <message lang="fr">Nombre maximal d’images par message</message>
        <message lang="en">Maximum images per message</message>
        <message lang="de">Maximale Bilderanzahl pro Nachricht</message>
      </label>
      <order>1</order>
      <mandatory>false</mandatory>
      <value>4</value>
      <type>text</type>
      <size>10</size>
      <updatable>always</updatable>
      <help>
        <message lang="fr">Entier strictement positif. Par défaut : 4.</message>
        <message lang="en">Positive integer. Default: 4.</message>
        <message lang="de">Positive ganze Zahl. Standard: 4.</message>
      </help>
    </parameter>
    <parameter>
      <name>maxImageSizeMb</name>
      <label>
        <message lang="fr">Taille maximale d’une image (Mo)</message>
        <message lang="en">Maximum image size (MB)</message>
        <message lang="de">Maximale Bildgröße (MB)</message>
      </label>
      <order>2</order>
      <mandatory>false</mandatory>
      <value>5</value>
      <type>text</type>
      <size>10</size>
      <updatable>always</updatable>
      <help>
        <message lang="fr">De 1 à 2047 Mo par image. Par défaut : 5 Mo.</message>
        <message lang="en">From 1 to 2047 MB per image. Default: 5 MB.</message>
        <message lang="de">1 bis 2047 MB pro Bild. Standard: 5 MB.</message>
      </help>
    </parameter>
    <parameter>
      <name>maxFileSizeMb</name>
      <label>
        <message lang="fr">Taille maximale d’un fichier (Mo)</message>
        <message lang="en">Maximum file size (MB)</message>
        <message lang="de">Maximale Dateigröße (MB)</message>
      </label>
      <order>3</order>
      <mandatory>false</mandatory>
      <value>20</value>
      <type>text</type>
      <size>10</size>
      <updatable>always</updatable>
      <help>
        <message lang="fr">De 1 à 2047 Mo par fichier. Par défaut : 20 Mo.</message>
        <message lang="en">From 1 to 2047 MB per file. Default: 20 MB.</message>
        <message lang="de">1 bis 2047 MB pro Datei. Standard: 20 MB.</message>
      </help>
    </parameter>
    <parameter>
      <name>maxFilesPerMessage</name>
      <label>
        <message lang="fr">Nombre maximal de fichiers par message</message>
        <message lang="en">Maximum files per message</message>
        <message lang="de">Maximale Dateianzahl pro Nachricht</message>
      </label>
      <order>4</order>
      <mandatory>false</mandatory>
      <value>4</value>
      <type>text</type>
      <size>10</size>
      <updatable>always</updatable>
      <help>
        <message lang="fr">Entier strictement positif. Par défaut : 4.</message>
        <message lang="en">Positive integer. Default: 4.</message>
        <message lang="de">Positive ganze Zahl. Standard: 4.</message>
      </help>
    </parameter>
  </parameters>
  <maxInstancesPerSpace>1</maxInstancesPerSpace>
</WAComponent>
