<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.silverpeas</groupId>
    <artifactId>components</artifactId>
    <version>6.5-SNAPSHOT</version>
  </parent>

  <groupId>org.silverpeas.components</groupId>
  <artifactId>silverpeas-components-restapi</artifactId>
  <packaging>jar</packaging>
  <name>Silverpeas Applications REST API Documentation ${project.version}</name>
  <description>
    The documentation of the REST API of the Silverpeas applications. This module produces nothing
    by itself: it gathers the documentation generated by each application exposing web resources
    in order to publish all of them at a single place. It is built only with the restapi profile.
  </description>

  <properties>
    <!-- nothing is compiled, tested, nor published here: this module only gathers and publishes
         the documentation generated by the other modules. -->
    <maven.main.skip>true</maven.main.skip>
    <maven.test.skip>true</maven.test.skip>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <!-- the whole REST API documentation is published on its own, aside from the Maven site of each
       application. Being explicit, this URL is used as such (the artifact identifier isn't
       appended to it as it is for an inherited one). -->
  <distributionManagement>
    <site>
      <id>silverpeas_repository</id>
      <url>scp://www.silverpeas.org/var/www/docs/restapi/components</url>
    </site>
  </distributionManagement>

  <!-- nothing is required from those artifacts but the guarantee this module is built, and hence
       gathers their documentation, once they all have been built. -->
  <dependencies>
    <dependency>
      <groupId>org.silverpeas.components.almanach</groupId>
      <artifactId>silverpeas-almanach-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.components.community</groupId>
      <artifactId>silverpeas-community-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.components.delegatednews</groupId>
      <artifactId>silverpeas-delegatednews-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.components.gallery</groupId>
      <artifactId>silverpeas-gallery-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.components.kmelia</groupId>
      <artifactId>silverpeas-kmelia-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.components.questionreply</groupId>
      <artifactId>silverpeas-questionreply-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.components.quickinfo</groupId>
      <artifactId>silverpeas-quickinfo-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.components.resourcesmanager</groupId>
      <artifactId>silverpeas-resourcesmanager-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.components.rssaggregator</groupId>
      <artifactId>silverpeas-rssaggregator-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.components.suggestionbox</groupId>
      <artifactId>silverpeas-suggestionbox-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <!-- the documentation of each application is generated by Smart-Doc into the target
               directory of its WAR module (out of its own Maven site); it is gathered here, into
               the site of this module, to be published all at once. -->
          <execution>
            <id>gather-restapi-doc</id>
            <phase>pre-site</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/site</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../almanach/almanach-war/target/restapi</directory>
                  <targetPath>almanach</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/../community/community-war/target/restapi</directory>
                  <targetPath>community</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/../delegatednews/delegatednews-war/target/restapi</directory>
                  <targetPath>delegatednews</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/../gallery/gallery-war/target/restapi</directory>
                  <targetPath>gallery</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/../kmelia/kmelia-war/target/restapi</directory>
                  <targetPath>kmelia</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/../questionReply/questionReply-war/target/restapi</directory>
                  <targetPath>questionReply</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/../quickinfo/quickinfo-war/target/restapi</directory>
                  <targetPath>quickinfo</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/../resourcesManager/resourcesManager-war/target/restapi</directory>
                  <targetPath>resourcesManager</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/../rssAggregator/rssAggregator-war/target/restapi</directory>
                  <targetPath>rssAggregator</targetPath>
                </resource>
                <resource>
                  <directory>${project.basedir}/../suggestionBox/suggestionBox-war/target/restapi</directory>
                  <targetPath>suggestionBox</targetPath>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
