      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <!-- the static part of the OpenAPI document, of which the version is filled in here -->
          <execution>
            <id>filter-openapi-base</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/openapi-base</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/main/openapi</directory>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
          <!-- the specification and the rendering page join the site: the index.html of Redoc
               must replace the one generated by the Maven site -->
          <execution>
            <id>gather-openapi-document</id>
            <phase>site</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/site</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.build.directory}/openapi</directory>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/site/resources</directory>
                </resource>
              </resources>
